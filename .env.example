POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit-local-only
POSTGRES_PORT=5432
ORBIT_DATABASE_URL=postgres://orbit:orbit-local-only@127.0.0.1:5432/orbit?sslmode=disable
ORBIT_LISTEN_ADDRESS=127.0.0.1:50051
ORBIT_SHUTDOWN_TIMEOUT=10s
ORBIT_DB_MAX_CONNECTIONS=10
ORBIT_GATEWAY_OUTBOUND_BUFFER=128
ORBIT_SCHEDULER_LEASE_BATCH=32
ORBIT_SCHEDULER_SWEEP_BATCH=64
ORBIT_SCHEDULER_LEASE_DURATION=15s
ORBIT_SCHEDULER_POLL_INTERVAL=250ms
ORBIT_GATEWAY_ID=gateway-1
ORBIT_CONTROL_ADDRESS=127.0.0.1:50051
ORBIT_GATEWAY_LISTEN_ADDRESS=127.0.0.1:50052
ORBIT_GATEWAY_SHUTDOWN_TIMEOUT=10s
ORBIT_GATEWAY_CONTROL_BUFFER=256
ORBIT_DEVICE_CONNECTION_BUFFER=16
ORBIT_GATEWAY_MAX_RECONNECT_ATTEMPTS=0
ORBIT_GATEWAY_RECONNECT_INITIAL_DELAY=250ms
ORBIT_GATEWAY_RECONNECT_MAX_DELAY=10s
ORBIT_DEVICE_ID=edge-1
ORBIT_CLIENT_GATEWAY_ADDRESS=127.0.0.1:50052
ORBIT_CLIENT_STATE_PATH=data/orbit-client-state.json
ORBIT_CLIENT_DEDUP_RETENTION=1024
ORBIT_CLIENT_MAX_RECONNECT_ATTEMPTS=0
ORBIT_CLIENT_RECONNECT_INITIAL_DELAY=250ms
ORBIT_CLIENT_RECONNECT_MAX_DELAY=10s
