root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{go,cpp,hpp,h,c,cmake,json,yml,yaml,md,sql}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 4
