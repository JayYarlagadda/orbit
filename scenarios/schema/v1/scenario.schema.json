{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JayYarlagadda/orbit/scenarios/schema/v1/scenario.schema.json",
  "title": "Orbit fault scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "seed",
    "duration_ms",
    "topology",
    "network_profile",
    "events"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": ".*\\S.*"
    },
    "seed": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical unsigned 64-bit decimal string. Runtime validation enforces the upper bound."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "topology": {
      "$ref": "#/$defs/topology"
    },
    "network_profile": {
      "$ref": "#/$defs/networkProfile"
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/deviceEvent" },
          { "$ref": "#/$defs/gatewayEvent" },
          { "$ref": "#/$defs/transportProfileEvent" }
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateways", "devices"],
      "properties": {
        "gateways": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "networkProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_ms",
        "jitter_ms",
        "delivery_loss_rate",
        "ack_loss_rate",
        "duplicate_rate"
      ],
      "properties": {
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "jitter_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "delivery_loss_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ack_loss_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duplicate_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "deviceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_ms", "type", "device_id"],
      "properties": {
        "at_ms": { "type": "integer", "minimum": 0 },
        "type": {
          "enum": ["device_disconnect", "device_reconnect", "device_gateway_switch"]
        },
        "device_id": { "$ref": "#/$defs/identifier" },
        "gateway_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "gatewayEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_ms", "type", "gateway_id"],
      "properties": {
        "at_ms": { "type": "integer", "minimum": 0 },
        "type": {
          "enum": ["gateway_crash", "gateway_recover"]
        },
        "gateway_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "transportProfileEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_ms", "type", "device_id", "profile"],
      "properties": {
        "at_ms": { "type": "integer", "minimum": 0 },
        "type": { "const": "transport_profile" },
        "device_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "const": "*" }
          ]
        },
        "profile": { "$ref": "#/$defs/networkProfile" }
      }
    }
  }
}
